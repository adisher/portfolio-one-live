# ─── Auto-injected by Upstash Vercel Marketplace Integration ─────────────────
# These are provisioned automatically when deploying via the one-click button.
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ─── Email (for password reset) ───────────────────────────────────────────────
# Required for the "Forgot password?" flow. Get a free API key at resend.com.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: the From address in reset emails. Must be a domain verified in Resend.
# Defaults to onboarding@resend.dev (fine for testing; set this for production).
# RESEND_FROM_EMAIL=noreply@yourdomain.com
#
# If you completed setup before the email field was added, set this once to
# seed your recovery email. It is written to Redis on first use and can then
# be removed from your env vars.
# ADMIN_RECOVERY_EMAIL=you@example.com
